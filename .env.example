# Banco de dados usado para armazenar leads e usuários.
MONGODB_URI=
MONGODB_DB=thynkxp

# Acesso da área administrativa.
ADMIN_EMAIL=arthur.ferreira@thynkxp.com.br

# No código atual, esta variável funciona como a senha do admin e também é
# usada pelo endpoint de bootstrap. Configure o valor real somente no ambiente
# de deploy/local (.env.local), nunca no GitHub.
ADMIN_BOOTSTRAP_SECRET=

# Chave usada para assinar o cookie de sessão do admin. Use uma chave longa,
# aleatória e diferente da senha acima.
ADMIN_SESSION_SECRET=
