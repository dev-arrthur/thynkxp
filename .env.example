# Banco de dados usado para armazenar leads, clientes, domínios, projetos e chamados.
MONGODB_URI=
MONGODB_DB=thynkxp

# Acesso da área administrativa.
ADMIN_EMAIL=arthur.ferreira@thynkxp.com.br

# Senha do admin. Configure somente no ambiente local/deploy e nunca publique
# esse valor no repositório ou no bundle do navegador.
ADMIN_PASSWORD=

# Recomendado em produção: segredo aleatório exclusivo com pelo menos 32
# caracteres. Se não for informado, o admin continua funcionando com um segredo
# derivado de ADMIN_PASSWORD para não depender do MongoDB durante o login.
ADMIN_SESSION_SECRET=

# Fonte cadastral do Radar de Leads. O padrão usa o projeto Minha Receita,
# com dados públicos de CNPJ. Só altere se estiver usando uma instância compatível.
CNPJ_SEARCH_BASE_URL=https://minhareceita.org

# Enriquecimento digital opcional do Radar.
# Google Places também habilita a camada geográfica por raio.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_PAGES=2

# Brave Search: descoberta de site, Instagram e outros sinais públicos na web.
BRAVE_SEARCH_API_KEY=

# Provedor opcional adicional para Google Search.
SERPER_API_KEY=

# Portal do cliente — contas individuais criadas pelo painel admin.
# Recomendado: segredo dedicado de 32+ caracteres. Se vazio, a sessão do cliente
# deriva um segredo da configuração administrativa existente (ADMIN_SESSION_SECRET
# ou ADMIN_PASSWORD), mantendo as contas individuais funcionais em produção.
CLIENT_PORTAL_SESSION_SECRET=

# O portal autentica contas individuais cadastradas em Admin > Clientes.
# Credenciais antigas de demonstração ou de um único cliente não são usadas.

# Envio opcional das credenciais do cliente após o cadastro.
# O sistema usa a API do Resend apenas no servidor e nunca persiste a senha em texto puro.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: sobrescreve RESEND_FROM_EMAIL somente para e-mails de acesso do cliente.
CLIENT_ACCESS_FROM_EMAIL=
