# Banco de dados usado para armazenar leads e dados do CRM.
MONGODB_URI=
MONGODB_DB=thynkxp

# Acesso da área administrativa.
ADMIN_EMAIL=arthur.ferreira@thynkxp.com.br

# Senha do admin. Configure somente no ambiente local/deploy e nunca publique
# esse valor no repositório ou no bundle do navegador.
ADMIN_PASSWORD=

# Recomendado em produção: segredo aleatório exclusivo com pelo menos 32
# caracteres. Se não for informado, o admin continua funcionando com um segredo
# derivado de ADMIN_PASSWORD para não depender do MongoDB durante o login.
ADMIN_SESSION_SECRET=

# Fonte do Radar de Leads. O padrão usa o projeto aberto Minha Receita, que
# processa dados públicos de CNPJ da Receita Federal. Só altere se estiver usando
# uma instância própria/compatível.
CNPJ_SEARCH_BASE_URL=https://minhareceita.org

# Portal do cliente. Em desenvolvimento, o template ainda pode usar os dados
# demo internos. Em produção, os três valores abaixo são obrigatórios: não há
# fallback de credencial ou segredo padrão.
CLIENT_PORTAL_EMAIL=
# SHA-256 da senha do cliente. Gere fora do repositório e salve apenas o hash.
CLIENT_PORTAL_PASSWORD_HASH=
# Use um segredo aleatório exclusivo com pelo menos 32 caracteres.
CLIENT_PORTAL_SESSION_SECRET=
